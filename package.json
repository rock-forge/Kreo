{
  "name": "kreo",
  "version": "1.0.0",
  "main": "devrock.js",
  "scripts": {
    "start:bot": "node --no-deprecation devrock.js",
    "start:dash": "npm run start --prefix dashboard",
    "dev:bot": "node --no-deprecation devrock.js",
    "dev:dash": "npm run dev --prefix dashboard",
    "dev": "concurrently -n \"BOT,DASH\" -c \"magenta,blue\" \"npm run dev:bot\" \"npm run dev:dash\"",
    "start": "concurrently -n \"BOT,DASH\" -c \"magenta,blue\" \"npm run start:bot\" \"npm run start:dash\"",
    "test": "node --test --test-concurrency=1",
    "check:services": "node scripts/check-services.cjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.26.3",
    "dokdo": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kazagumo": "^3.4.3",
    "kazagumo-spotify": "^2.1.1",
    "lodash": "^4.18.1",
    "moment-timezone": "^0.6.2",
    "mongoose": "^9.5.0",
    "ms": "^2.1.3",
    "shoukaku": "^4.3.0",
    "socket.io": "^4.8.3",
    "ssh2": "^1.17.0",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "author": "rock-forge",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/rock-forge/Kreo.git"
  },
  "homepage": "https://github.com/rock-forge/Kreo#readme",
  "bugs": {
    "url": "https://github.com/rock-forge/Kreo/issues"
  }
}
